<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DFRContentHost.Models"
             x:Class="DFRContentHost.MainView"
             Background="Black">
    <UserControl.Styles>
        <!-- Standard touch bar button -->
        <Style Selector="Button.dfrbtn">
            <Setter Property="Background" Value="#FF282828" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dfrbtn /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.dfrbtn:pointerover">
            <Setter Property="Background" Value="#FF3E3E42" />
        </Style>
        <Style Selector="Button.dfrbtn:pressed">
            <Setter Property="Background" Value="#FF0078D7" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.dfrbtn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Keyboard key style -->
        <Style Selector="Button.dfrkey">
            <Setter Property="Background" Value="#FF222224" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dfrkey /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.dfrkey:pointerover">
            <Setter Property="Background" Value="#FF3A3A3E" />
        </Style>
        <Style Selector="Button.dfrkey:pressed">
            <Setter Property="Background" Value="#FF0078D7" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- System right-side buttons -->
        <Style Selector="Button.dfrsysbtn">
            <Setter Property="Background" Value="#FF242426" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.dfrsysbtn /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.dfrsysbtn:pointerover">
            <Setter Property="Background" Value="#FF3A3A3D" />
        </Style>
        <Style Selector="Button.dfrsysbtn:pressed">
            <Setter Property="Background" Value="#FF0078D7" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- Volume step buttons: narrow -->
        <Style Selector="Button.dfrvol">
            <Setter Property="Background" Value="#FF1A1A1C" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.dfrvol /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.dfrvol:pressed">
            <Setter Property="Background" Value="#FF0078D7" />
        </Style>
    </UserControl.Styles>

    <Grid Width="1000" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Col 0: Mode toggles (Fn, Az) + F1-F12 keys -->
            <ColumnDefinition Width="Auto" />
            <!-- Col 1: Middle section (Volume panel / Virtual Keyboard / Desktop Strip) -->
            <ColumnDefinition Width="*" />
            <!-- Col 2: System Status (App name, Clock, Battery, Wifi) -->
            <ColumnDefinition Width="Auto" />
            <!-- Col 3: System Quick Buttons (Volume toggle, Lock) -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT: MODE TOGGLES & F-KEYS ==================== -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">

            <!-- Fn Key Toggle Button -->
            <Button Classes="dfrbtn"
                    Width="32" Height="26" Margin="1,0"
                    Background="{Binding FnKeyViewModel.FnButton.BackgroundBrush}"
                    Content="{Binding FnKeyViewModel.FnButton.Content}"
                    Command="{Binding FnKeyViewModel.FnButton.KeyCommand}" />

            <!-- Az Keyboard Toggle Button -->
            <Button Classes="dfrbtn"
                    Width="32" Height="26" Margin="1,0"
                    Background="{Binding KeyboardViewModel.AzButton.BackgroundBrush}"
                    Content="{Binding KeyboardViewModel.AzButton.Content}"
                    Command="{Binding KeyboardViewModel.AzButton.KeyCommand}" />

            <!-- F1 - F12 Keys (visible when Fn is toggled) -->
            <ItemsControl Items="{Binding FnKeyViewModel.FnKeys}"
                          IsVisible="{Binding FunctionKeysVisible}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:FunctionRowButtonModel">
                        <Button Classes="dfrbtn"
                                Width="{Binding Width}" Height="26" Margin="1.5,0"
                                Content="{Binding Content}"
                                Command="{Binding KeyCommand}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ==================== MIDDLE: VOLUME PANEL / KEYBOARD / DESKTOP STRIP ==================== -->
        <Grid Grid.Column="1" VerticalAlignment="Center">

            <Border Width="356" Height="42" Padding="8,0" CornerRadius="6"
                    Background="#FFBDEBFA" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding SmtcViewModel.IsVolumeSliderVisible}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas Width="280" Height="30" Background="Transparent" Tag="Volume"
                            PointerPressed="OnSliderPointerPressed"
                            PointerMoved="OnSliderPointerMoved"
                            PointerReleased="OnSliderPointerReleased">
                        <Border Canvas.Left="0" Canvas.Top="13" Width="280" Height="4"
                                CornerRadius="2" Background="#FF739AAA" />
                        <Border Canvas.Left="0" Canvas.Top="13"
                                Width="{Binding SmtcViewModel.VolumeSliderFillWidth}" Height="4"
                                CornerRadius="2" Background="#FF317F9C" />
                        <Border Canvas.Left="{Binding SmtcViewModel.VolumeSliderThumbLeft}" Canvas.Top="5"
                                Width="20" Height="20" CornerRadius="10"
                                Background="#FFFFFFFF" BorderBrush="#FF52798A" BorderThickness="1" />
                    </Canvas>
                    <TextBlock Width="48" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#FF263942" FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right" Text="{Binding SmtcViewModel.VolumePercentageText}" />
                </StackPanel>
            </Border>

            <Border Width="356" Height="42" Padding="8,0" CornerRadius="6"
                    Background="#FFBDEBFA" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding SmtcViewModel.IsBrightnessSliderVisible}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas Width="280" Height="30" Background="Transparent" Tag="Brightness"
                            PointerPressed="OnSliderPointerPressed"
                            PointerMoved="OnSliderPointerMoved"
                            PointerReleased="OnSliderPointerReleased">
                        <Border Canvas.Left="0" Canvas.Top="13" Width="280" Height="4"
                                CornerRadius="2" Background="#FF739AAA" />
                        <Border Canvas.Left="0" Canvas.Top="13"
                                Width="{Binding SmtcViewModel.BrightnessSliderFillWidth}" Height="4"
                                CornerRadius="2" Background="#FF317F9C" />
                        <Border Canvas.Left="{Binding SmtcViewModel.BrightnessSliderThumbLeft}" Canvas.Top="5"
                                Width="20" Height="20" CornerRadius="10"
                                Background="#FFFFFFFF" BorderBrush="#FF52798A" BorderThickness="1" />
                    </Canvas>
                    <TextBlock Width="48" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#FF263942" FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right" Text="{Binding SmtcViewModel.BrightnessPercentageText}" />
                </StackPanel>
            </Border>

            <!-- VIEW 2: Paginated Virtual Keyboard (no ScrollViewer — uses ◀/▶ buttons) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0"
                        IsVisible="{Binding IsKeyboardVisible}">

                <!-- Scroll LEFT arrow (disabled when at start) -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.ScrollLeftButton.Width}" Height="26" Margin="1,0"
                        IsEnabled="{Binding KeyboardViewModel.CanScrollLeft}"
                        Content="{Binding KeyboardViewModel.ScrollLeftButton.Content}"
                        Command="{Binding KeyboardViewModel.ScrollLeftButton.KeyCommand}" />

                <!-- Caps / Shift toggle -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.CapsButton.Width}" Height="26" Margin="1,0"
                        Background="{Binding KeyboardViewModel.CapsButton.BackgroundBrush}"
                        Content="{Binding KeyboardViewModel.CapsButton.Content}"
                        Command="{Binding KeyboardViewModel.CapsButton.KeyCommand}" />

                <!-- ?123 / ABC mode toggle -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.NumModeButton.Width}" Height="26" Margin="1,0"
                        Background="{Binding KeyboardViewModel.NumModeButton.BackgroundBrush}"
                        Content="{Binding KeyboardViewModel.NumModeButton.Content}"
                        Command="{Binding KeyboardViewModel.NumModeButton.KeyCommand}" />

                <!-- Visible key window (A-Z or symbols, current page) -->
                <ItemsControl Items="{Binding KeyboardViewModel.VisibleKeys}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:FunctionRowButtonModel">
                            <Button Classes="dfrkey"
                                    Width="{Binding Width}" Height="26" Margin="1,0"
                                    Content="{Binding Content}"
                                    Command="{Binding KeyCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Scroll RIGHT arrow (disabled at end) -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.ScrollRightButton.Width}" Height="26" Margin="1,0"
                        IsEnabled="{Binding KeyboardViewModel.CanScrollRight}"
                        Content="{Binding KeyboardViewModel.ScrollRightButton.Content}"
                        Command="{Binding KeyboardViewModel.ScrollRightButton.KeyCommand}" />

                <!-- Space -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.SpaceButton.Width}" Height="26" Margin="2,0,1,0"
                        Content="{Binding KeyboardViewModel.SpaceButton.Content}"
                        Command="{Binding KeyboardViewModel.SpaceButton.KeyCommand}" />

                <!-- Backspace -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.BackspaceButton.Width}" Height="26" Margin="1,0"
                        Content="{Binding KeyboardViewModel.BackspaceButton.Content}"
                        Command="{Binding KeyboardViewModel.BackspaceButton.KeyCommand}" />

                <!-- Enter -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.EnterButton.Width}" Height="26" Margin="1,0"
                        Content="{Binding KeyboardViewModel.EnterButton.Content}"
                        Command="{Binding KeyboardViewModel.EnterButton.KeyCommand}" />

                <!-- Tab -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.TabButton.Width}" Height="26" Margin="1,0"
                        Content="{Binding KeyboardViewModel.TabButton.Content}"
                        Command="{Binding KeyboardViewModel.TabButton.KeyCommand}" />

                <!-- Esc -->
                <Button Classes="dfrkey"
                        Width="{Binding KeyboardViewModel.EscButton.Width}" Height="26" Margin="1,0"
                        Content="{Binding KeyboardViewModel.EscButton.Content}"
                        Command="{Binding KeyboardViewModel.EscButton.KeyCommand}" />
            </StackPanel>

            <!-- VIEW 3: Standard Desktop Strip (Context Shortcuts & Media) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        IsVisible="{Binding IsDesktopStripVisible}">

                <!-- App Context Buttons (hidden when F-keys are showing) -->
                <ItemsControl Items="{Binding SmtcViewModel.ContextButtons}"
                              IsVisible="{Binding !FunctionKeysVisible}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:FunctionRowButtonModel">
                            <Button Classes="dfrbtn"
                                    Width="{Binding Width}" Height="26" Margin="1.5,0"
                                    FontFamily="{Binding FontFamily}"
                                    Content="{Binding Content}"
                                    Command="{Binding KeyCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Media Controls & Now Playing Strip -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                            IsVisible="{Binding SmtcViewModel.IsSmtcActive}">
                    <Border Width="1" Height="16" Background="#FF3A3A3D" Margin="2,0,4,0" />
                    <Border Width="22" Height="22" CornerRadius="4" ClipToBounds="True" Margin="2,0"
                            IsVisible="{Binding SmtcViewModel.ThumbnailAvailable}">
                        <Image Source="{Binding SmtcViewModel.MediaThumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <ItemsControl Items="{Binding SmtcViewModel.PlayControlKeys}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:FunctionRowButtonModel">
                                <Button Classes="dfrbtn"
                                        Width="30" Height="26" Margin="1,0"
                                        FontFamily="{Binding FontFamily}"
                                        Content="{Binding Content}"
                                        Command="{Binding KeyCommand}"
                                        IsEnabled="{Binding Enabled}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ==================== STATUS STRIP ==================== -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
            <TextBlock Margin="2,0,4,0" VerticalAlignment="Center"
                       Foreground="#FFE0E0E0" FontSize="11" FontWeight="SemiBold"
                       Text="{Binding SmtcViewModel.ClockText}" />

            <!-- Battery Icon with Text Inside -->
            <Grid Width="34" Height="14" Margin="4,0,4,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                </Grid.ColumnDefinitions>
                <!-- Battery body -->
                <Border Grid.Column="0" BorderThickness="1" BorderBrush="#FFB0B0B0" CornerRadius="2">
                    <Border HorizontalAlignment="Left" Background="{Binding SmtcViewModel.BatteryBrush}"
                            Width="{Binding SmtcViewModel.BatteryFillWidth}" Opacity="{Binding SmtcViewModel.BatteryOpacity}" />
                </Border>
                <!-- Battery nub -->
                <Border Grid.Column="1" Background="#FFB0B0B0" Height="6" CornerRadius="0,1,1,0" />
                
                <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#FFFFFFFF" FontSize="9" FontWeight="Bold"
                           Text="{Binding SmtcViewModel.BatteryText}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Height="13" VerticalAlignment="Center"
                        Margin="4,0,2,0" Spacing="1">
                <Border Width="3" Height="4" VerticalAlignment="Bottom" CornerRadius="1"
                        Background="#FFFFFFFF" Opacity="{Binding SmtcViewModel.WifiBar1Opacity}" />
                <Border Width="3" Height="7" VerticalAlignment="Bottom" CornerRadius="1"
                        Background="#FFFFFFFF" Opacity="{Binding SmtcViewModel.WifiBar2Opacity}" />
                <Border Width="3" Height="10" VerticalAlignment="Bottom" CornerRadius="1"
                        Background="#FFFFFFFF" Opacity="{Binding SmtcViewModel.WifiBar3Opacity}" />
                <Border Width="3" Height="13" VerticalAlignment="Bottom" CornerRadius="1"
                        Background="#FFFFFFFF" Opacity="{Binding SmtcViewModel.WifiBar4Opacity}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== RIGHT: SYSTEM QUICK BUTTONS ==================== -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
            <Button Classes="dfrsysbtn"
                FontFamily="Segoe MDL2 Assets"
                Content="{Binding SmtcViewModel.VolumeButton.Content}"
                Background="{Binding SmtcViewModel.VolumeButton.BackgroundBrush}"
                Command="{Binding SmtcViewModel.VolumeButton.KeyCommand}" />

            <Button Classes="dfrsysbtn" Margin="2,0"
                    FontFamily="Segoe MDL2 Assets"
                    Content="{Binding SmtcViewModel.BrightnessButton.Content}"
                    Background="{Binding SmtcViewModel.BrightnessButton.BackgroundBrush}"
                    Command="{Binding SmtcViewModel.BrightnessButton.KeyCommand}" />

            <Border Width="1" Height="16" Background="#FF3A3A3D" Margin="8,0" />

            <!-- Lock Workstation -->
            <Button Classes="dfrsysbtn"
                    FontFamily="Segoe MDL2 Assets"
                    Content="{Binding SmtcViewModel.LockButton.Content}"
                    Command="{Binding SmtcViewModel.LockButton.KeyCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
